<idea-plugin>
    <id>me.nibo.spring-url-scanner</id>
    <name>Spring URL Scanner</name>
    <vendor email="nibocn@gmail.com">NiBo</vendor>

    <description><![CDATA[
        Spring URL Scanner finds Spring MVC controller endpoints and OpenFeign client mappings in Java projects.
    ]]></description>
    <change-notes><![CDATA[
        Add endpoint copy support.
    ]]></change-notes>
    <icon>/META-INF/pluginIcon.svg</icon>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Spring URLs"
                anchor="right"
                icon="/icons/springUrlToolWindow.svg"
                factoryClass="me.nibo.springurlscanner.SpringUrlToolWindowFactory"/>
    </extensions>
</idea-plugin>
